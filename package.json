    "verify": "npm run verify:ab-union && npm run verify:snapshots && npm run verify:cunion"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "three": "^0.185.0"
  }
}
